{
  "manifest_version": 3,
  "name": "AI Online Brain",
  "version": "0.1.0",
  "description": "Chat con Claude en una ventana flotante o panel lateral de Chrome, con el contexto de la pestaña actual.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "sidePanel", "activeTab", "scripting"],
  "host_permissions": ["https://api.anthropic.com/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "AI Online Brain"
  },
  "side_panel": {
    "default_path": "src/chat.html"
  },
  "commands": {
    "open-window": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Abrir el chat en una ventana flotante"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
