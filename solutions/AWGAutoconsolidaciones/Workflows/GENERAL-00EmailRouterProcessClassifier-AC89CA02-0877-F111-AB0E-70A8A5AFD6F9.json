                                          "Method": "PATCH",
                                          "CustomHeader1": "Prefer: IdType=\"ImmutableId\"",
                                          "Body": "@concat('{\"isRead\":', if(equals(outputs('GENERAL_-_00_Rule_Classification'), 'ZQs'), 'true', 'false'), ',\"categories\":[\"', outputs('GENERAL_-_00_Rule_Classification'), '\"]}')",
                                          "ContentType": "application/json"
                                        },
                                        "host": {
                                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
                                          "connectionName": "shared_office365",
                                          "operationId": "HttpRequest"
                                        },
                                        "authentication": "@parameters('$authentication')"
                                      }
                                    }
                                  },
                                  "else": {
                                    "actions": {
                                      "GENERAL_-_00_HTTP_Reply_Original_to_OSSGenAI_SameThread": {
                                        "runAfter": {},
                                        "type": "OpenApiConnection",
                                        "inputs": {
                                          "parameters": {
                                            "Uri": "v1.0/me/messages/@{encodeUriComponent(outputs('Compose_Original_Immutable_ID'))}/reply",
                                            "Method": "POST",
                                            "CustomHeader1": "Prefer: IdType=\"ImmutableId\"",
                                            "ContentType": "application/json",
                                            "Body": "@concat('{\"message\": {\"toRecipients\": [{\"emailAddress\": {\"address\": \"ossgenai.im@pg.com\"}}], \"ccRecipients\": [], \"bccRecipients\": []}, \"comment\": \"', outputs('GENERAL_-_00_Rule_Reply_Comment'), '\"}')"
                                          },
                                          "host": {
                                            "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
                                            "connectionName": "shared_office365",
                                            "operationId": "HttpRequest"
                                          },
                                          "authentication": "@parameters('$authentication')"
                                        }
                                      }
                                    }
                                  }
                                }
                              }
                            },
                            "expression": {
