                        },
                        "host": {
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
                          "connectionName": "shared_office365",
                          "operationId": "HttpRequest"
                        },
                        "authentication": "@parameters('$authentication')"
                      }
                    },
                    "AWG_-_CON_-_03_Compose_MOC_Attachment_Base64": {
                      "runAfter": {
                        "Get_file_content": [
                          "Succeeded"
                        ]
                      },
                      "type": "Compose",
                      "inputs": "@base64(body('Get_file_content'))"
                    },
                    "AWG_-_CON_-_03_HTTP_Send_Created_Consolidation_Message": {
                      "runAfter": {
                        "AWG_-_CON_-_03_HTTP_Send_Consolidation_Request": [
                          "Succeeded"
                        ]
                      },
                      "type": "OpenApiConnection",
                      "inputs": {
                        "parameters": {
                          "Uri": "v1.0/me/messages/@{encodeUriComponent(body('AWG_-_CON_-_03_HTTP_Send_Consolidation_Request')?['id'])}/send",
                          "Method": "POST",
                          "CustomHeader1": "Prefer: IdType=\"ImmutableId\"",
                          "Body": "{}",
                          "ContentType": "application/json"
                        },
                        "host": {
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
                          "connectionName": "shared_office365",
                          "operationId": "HttpRequest"
                        },
                        "authentication": "@parameters('$authentication')"
                      }
                    }
                  },
                  "else": {
                    "actions": {}
                  },
                  "expression": {
                    "and": [
                      {
                        "not": {
                          "contains": [
                            "@toLower(triggerOutputs()?['body/body'])",
                            "final state results"
                          ]
                        }
                      },
                      {
                        "not": {
                          "contains": [
                            "@toLower(triggerOutputs()?['body/body'])",
                            "delivery number"
                          ]
                        }
                      }
                    ]
                  },
                  "type": "If"
                }
              },
              "runAfter": {
