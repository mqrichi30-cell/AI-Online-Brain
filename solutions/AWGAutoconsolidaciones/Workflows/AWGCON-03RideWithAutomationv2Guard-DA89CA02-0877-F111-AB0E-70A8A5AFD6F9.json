                          "Method": "POST",
                          "CustomHeader1": "Prefer: IdType=\"ImmutableId\"",
                          "Body": "{\n  \"destinationId\": \"AAMkAGMzNjc1ZDRmLTFlOTktNGQzNS04NTVmLTkwMDVkOWEyYmY0MQAuAAAAAACUFGw_S0XqRK5id50_416QAQCJMa30OofZSrcZSkuH_Y6QAAAiDm4CAAA=\"\n}",
                          "ContentType": "application/json"
