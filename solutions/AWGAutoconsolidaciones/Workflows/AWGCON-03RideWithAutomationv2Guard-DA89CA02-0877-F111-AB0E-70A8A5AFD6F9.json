                    ]
                  },
                  {
                    "contains": [
                      "@toLower(triggerOutputs()?['body/body'])",
                      "this is an automatic notification that the following purchase order(s) are scheduled to ride with another load:"
                    ]
                  }
                ]
              },
              "type": "If"
            }
          },
          "runAfter": {
