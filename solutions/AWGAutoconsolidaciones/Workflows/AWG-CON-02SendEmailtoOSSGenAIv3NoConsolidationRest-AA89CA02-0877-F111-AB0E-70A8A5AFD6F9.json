            "CheckAlreadyProcessedConsolidation": {
              "actions": {
                "Compose_ResponseBody": {
                  "type": "Compose",
                  "inputs": "@triggerOutputs()?['body/body']"
                },
                "Extract_Formatted_Table_Section": {
                  "runAfter": {
                    "Compose_ResponseBody": [
                      "Succeeded"
                    ]
                  },
                  "type": "Compose",
                  "inputs": "@first(\r\n  split(\r\n    last(split(outputs('Compose_CurrentEmailOnly'), 'Formatted Table')),\r\n    '</table>'\r\n  )\r\n)"
                },
                "Extract_Table_Rows": {
                  "runAfter": {
                    "Extract_Formatted_Table_Section": [
                      "Succeeded"
                    ]
                  },
                  "type": "Compose",
                  "inputs": "@skip(\r\n  split(outputs('Extract_Formatted_Table_Section'), '<tr'),\r\n  2\r\n)"
                },
                "Apply_to_each_TableRow": {
                  "foreach": "@outputs('Extract_Table_Rows')",
                  "actions": {
                    "Compose_PO_From_Row": {
                      "type": "Compose",
                      "inputs": "@trim(\r\n  first(\r\n    split(\r\n      last(\r\n        split(\r\n          first(\r\n            skip(\r\n              split(item(), '</td>'),\r\n              1\r\n            )\r\n          ),\r\n          '>'\r\n        )\r\n      ),\r\n      '<'\r\n    )\r\n  )\r\n)"
                    },
                    "Append_to_array_variable": {
                      "runAfter": {
                        "Compose_PO_From_Row": [
                          "Succeeded"
                        ]
                      },
                      "type": "AppendToArrayVariable",
                      "inputs": {
                        "name": "varPOs",
                        "value": "@outputs('Compose_PO_From_Row')"
                      }
                    },
                    "Compose_SO_From_Row": {
                      "runAfter": {
                        "Append_to_array_variable": [
                          "Succeeded"
                        ]
                      },
                      "type": "Compose",
                      "inputs": "@if(greater(length(split(item(), '</td>')), 2), trim(first(split(last(split(first(skip(split(item(), '</td>'), 2)), '>')), '<'))), '')"
                    },
                    "Append_to_array_variable_-_SOs": {
                      "runAfter": {
                        "Compose_SO_From_Row": [
                          "Succeeded"
                        ]
                      },
                      "type": "AppendToArrayVariable",
                      "inputs": {
                        "name": "varSOs",
                        "value": "@outputs('Compose_SO_From_Row')"
                      }
                    }
                  },
                  "runAfter": {
                    "Extract_Table_Rows": [
                      "Succeeded"
                    ]
                  },
                  "type": "Foreach"
                },
                "Check_POs_Extracted": {
                  "actions": {
                    "AWG_-_CON_-_02_Compose_Reply_HTML": {
                      "runAfter": {},
                      "type": "Compose",
                      "inputs": "@concat(\n  '<div><p>P&amp;G Team,</p>',\n  '<p>This is an automatic notification that the following Purchase Order(s) are scheduled to ride with another load:</p>',\n  '<ul>',\n  '<li><strong>Main PO Number (The load):</strong> ', first(variables('varPOs')), '</li>',\n  '<li><strong>Riding With PO(s) (The load/s it is attached to):</strong> ', join(skip(variables('varPOs'),1), ', '), '</li>',\n  '<li><strong>Ship-to Location:</strong> N/A</li>',\n  '</ul>',\n  '<p>Please ensure that PO #', first(variables('varPOs')), ' is consolidated with the load for PO(s) #', join(skip(variables('varPOs'),1), ', '), '.</p>',\n  '<p>Regards,</p>',\n  '<p>pgcustservw2.im@pg.com<br>NA Order Management | Regional</p>',\n  '<p style=\"font-size:1px;color:#ffffff;line-height:1px\">AWG-FLOW-ID: ', outputs('Compose_FlowId_From_Body'), ' | AWG-STEP: RIDE_WITH_REQUEST</p>',\n  '</div>'\n)"
                    },
                    "AWG_-_CON_-_02_Move_Original_Email_to_Complete": {
                      "runAfter": {
