{
  "name": "717b17a8-5264-4ee5-b5c0-779186436c4d",
  "id": "/providers/Microsoft.Flow/flows/717b17a8-5264-4ee5-b5c0-779186436c4d",
  "type": "Microsoft.Flow/flows",
  "properties": {
    "apiId": "/providers/Microsoft.PowerApps/apis/shared_logicflows",
    "displayName": "Wakefern - YV block - Stage 1 Request Qty",
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        }
      },
      "triggers": {
        "When_a_new_email_arrives_(V3)": {
          "splitOn": "@triggerOutputs()?['body/value']",
          "type": "OpenApiConnectionNotification",
          "inputs": {
            "parameters": {
              "from": "pgcustservw1.im@pg.com;pgcustservw2.im@pg.com",
              "includeAttachments": true,
              "subjectFilter": "Regional Report",
              "fetchOnlyWithAttachment": true,
              "folderPath": "Id::AAMkAGMzNjc1ZDRmLTFlOTktNGQzNS04NTVmLTkwMDVkOWEyYmY0MQAuAAAAAACUFGw_S0XqRK5id50_416QAQCJMa30OofZSrcZSkuH_Y6QAAU07ZH6AAA="
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
              "connectionName": "shared_office365",
              "operationId": "OnNewEmailV3"
            },
            "authentication": "@parameters('$authentication')"
          }
        }
      },
      "actions": {
        "Only_Regional_Report_Subject": {
          "type": "If",
          "runAfter": {},
          "expression": {
            "and": [
              {
                "startsWith": [
                  "@triggerOutputs()?['body/subject']",
                  "Regional Report"
                ]
              }
            ]
          },
          "else": {
            "actions": {
              "Ignored_Not_Regional_Report": {
                "type": "Compose",
                "inputs": "Ignored because subject does not start with Regional Report."
              }
            }
          },
          "actions": {
            "Filter_XLSX_Attachments": {
              "type": "Query",
              "inputs": {
                "from": "@triggerOutputs()?['body/attachments']",
                "where": "@and(endsWith(toLower(item()?['name']), '.xlsx'), equals(coalesce(item()?['isInline'], false), false))"
              }
            },
            "Apply_to_each_XLSX_Attachment": {
              "type": "Foreach",
              "runAfter": {
                "Filter_XLSX_Attachments": [
                  "Succeeded"
                ]
              },
              "foreach": "@body('Filter_XLSX_Attachments')",
              "actions": {
                "Create_Temp_Excel_File": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "parameters": {
                      "folderPath": "/",
                      "name": "@concat('Regional_Report_Wakefern_YV_', formatDateTime(utcNow(), 'yyyyMMdd_HHmmssfff'), '.xlsx')",
                      "body": "@base64ToBinary(items('Apply_to_each_XLSX_Attachment')?['contentBytes'])"
                    },
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_onedriveforbusiness",
                      "connectionName": "shared_onedriveforbusiness",
                      "operationId": "CreateFile"
                    },
                    "authentication": "@parameters('$authentication')"
                  }
                },
                "Run_script_ProcessWakefernYV": {
                  "type": "OpenApiConnection",
                  "runAfter": {
                    "Create_Temp_Excel_File": [
                      "Succeeded"
                    ]
                  },
                  "inputs": {
                    "parameters": {
                      "source": "me",
                      "drive": "me",
                      "file": "@outputs('Create_Temp_Excel_File')?['body/Id']",
                      "scriptId": "ms-officescript%3A%2F%2Fonedrive_business_itemlink%2F01DYYVZGXRHHDY4HR32VGID4O5BXO2MOKB"
                    },
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_excelonlinebusiness",
                      "connectionName": "shared_excelonlinebusiness",
                      "operationId": "RunScriptProd"
                    },
                    "authentication": "@parameters('$authentication')"
                  },
                  "description": "Runs Office Script ProcessWakefernYV against the temp Excel. Filters Del Blk Indicator = YV and RDD between today and today+10. IMPORTANT: scriptId currently points to the 11s script as a valid placeholder so the package imports; after importing, repoint this action to the real ProcessWakefernYV script."
                },
                "Compose_YV_Script_Result": {
                  "type": "Compose",
                  "runAfter": {
                    "Run_script_ProcessWakefernYV": [
                      "Succeeded"
                    ]
                  },
                  "inputs": "@body('Run_script_ProcessWakefernYV')?['result']"
                },
                "Parse_YV_Script_Result": {
                  "type": "ParseJson",
                  "runAfter": {
                    "Compose_YV_Script_Result": [
                      "Succeeded"
                    ]
                  },
                  "inputs": {
                    "content": "@outputs('Compose_YV_Script_Result')",
                    "schema": {
                      "type": "object",
                      "properties": {
                        "rowCount": {
                          "type": "integer"
                        },
                        "ossHtmlRows": {
                          "type": "string"
                        },
                        "todayIso": {
                          "type": "string"
                        },
                        "maxRddIso": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "rowCount",
                        "ossHtmlRows",
                        "todayIso",
                        "maxRddIso"
                      ]
                    }
                  }
                },
                "Debug_Parsed_YV_Result": {
                  "type": "Compose",
                  "runAfter": {
                    "Parse_YV_Script_Result": [
                      "Succeeded"
                    ]
                  },
                  "inputs": "@body('Parse_YV_Script_Result')",
                  "description": "DEBUG: click first. Confirms rowCount, today, maxRdd (today+10) and generated HTML rows."
                },
                "If_YV_Rows_Found": {
                  "type": "If",
                  "runAfter": {
                    "Debug_Parsed_YV_Result": [
                      "Succeeded"
                    ]
                  },
                  "expression": {
                    "and": [
                      {
                        "greater": [
                          "@body('Parse_YV_Script_Result')?['rowCount']",
                          0
                        ]
                      }
                    ]
                  },
                  "else": {
                    "actions": {
                      "No_YV_Rows": {
                        "type": "Compose",
                        "inputs": "No Wakefern YV rows within RDD today..today+10 were found."
                      }
                    }
                  },
                  "actions": {
                    "Debug_OSS_YV_Draft_JSON": {
                      "type": "Compose",
                      "inputs": "@concat('{\"subject\":\"Wakefern YV Qty Confirmation Request - ',formatDateTime(convertTimeZone(utcNow(),'UTC','Central America Standard Time'),'yyyy-MM-dd'),'\",\"body\":{\"contentType\":\"HTML\",\"content\":\"Hello,<br><br>These Wakefern lines have Del Blk Indicator = YV with RDD within the next 10 days (today through today+10). Please provide the Target QTY and Confirmed Qty for each line.<br><br><b>Lines:</b><br><table border=1 cellspacing=0 cellpadding=4><tr><th>SO #</th><th>Line #</th><th>RDD</th></tr>',body('Parse_YV_Script_Result')?['ossHtmlRows'],'</table><br><br><b>IMPORTANT - REPLY FORMAT (do not change):</b><br>Reply to this email including the block below EXACTLY as shown: same header, same 4 columns, same order, pipe (|) separated, one line per row, plain text only (no bold, no tables, no HTML, no extra text) between the markers. Provide Target QTY and Confirmed Qty for every SO#/Line# above.<br><br>###PGYV-START###<br>SO#|Line#|Target QTY|Confirmed Qty<br>&lt;SO#&gt;|&lt;Line#&gt;|&lt;Target QTY&gt;|&lt;Confirmed Qty&gt;<br>###PGYV-END###<br><br>Regards,<br>pgcustservw2.im@pg.com<br>NA Order Management | Regional\"},\"toRecipients\":[{\"emailAddress\":{\"address\":\"ossgenai.im@pg.com\"}}]}')",
                      "description": "DEBUG: exact JSON string converted with json() and sent to Office 365 HTTP for the OSS YV request draft."
                    },
                    "Debug_OSS_YV_HTTP_URI": {
                      "type": "Compose",
                      "runAfter": {
                        "Debug_OSS_YV_Draft_JSON": [
                          "Succeeded"
                        ]
                      },
                      "inputs": "https://graph.microsoft.com/v1.0/me/messages"
                    },
                    "Create_OSS_YV_Draft_HTTP": {
                      "type": "OpenApiConnection",
                      "runAfter": {
                        "Debug_OSS_YV_HTTP_URI": [
                          "Succeeded"
                        ]
                      },
                      "inputs": {
                        "parameters": {
                          "Uri": "https://graph.microsoft.com/v1.0/me/messages",
                          "Method": "POST",
                          "Body": "@json(outputs('Debug_OSS_YV_Draft_JSON'))",
                          "ContentType": "application/json"
                        },
                        "host": {
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
                          "connectionName": "shared_office365",
                          "operationId": "HttpRequest"
                        },
                        "authentication": "@parameters('$authentication')"
                      },
                      "description": "Creates the OSS YV request draft (Graph me/messages)."
                    },
                    "Send_OSS_YV_Draft_HTTP": {
                      "type": "OpenApiConnection",
                      "runAfter": {
                        "Create_OSS_YV_Draft_HTTP": [
                          "Succeeded"
                        ]
                      },
                      "inputs": {
                        "parameters": {
                          "Uri": "@concat('https://graph.microsoft.com/v1.0/me/messages/', body('Create_OSS_YV_Draft_HTTP')?['id'], '/send')",
                          "Method": "POST",
                          "Body": "@json('{}')",
                          "ContentType": "application/json"
                        },
                        "host": {
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
                          "connectionName": "shared_office365",
                          "operationId": "HttpRequest"
                        },
                        "authentication": "@parameters('$authentication')"
                      },
                      "description": "Sends the OSS YV request draft (me/messages/{id}/send)."
                    },
                    "Debug_OSS_YV_Create_Error": {
                      "type": "Compose",
                      "runAfter": {
                        "Create_OSS_YV_Draft_HTTP": [
                          "Failed",
                          "TimedOut"
                        ]
                      },
                      "inputs": "@outputs('Create_OSS_YV_Draft_HTTP')"
                    },
                    "Debug_OSS_YV_Send_Error": {
                      "type": "Compose",
                      "runAfter": {
                        "Send_OSS_YV_Draft_HTTP": [
                          "Failed",
                          "TimedOut"
                        ]
                      },
                      "inputs": "@outputs('Send_OSS_YV_Draft_HTTP')"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "outputs": {}
    },
    "connectionReferences": {
      "shared_office365": {
        "connectionName": "shared-office365-89c9854a-cfbd-48e5-acd3-cb019798a1ee",
        "source": "Embedded",
        "id": "/providers/Microsoft.PowerApps/apis/shared_office365",
        "tier": "NotSpecified",
        "apiName": "office365",
        "isProcessSimpleApiReferenceConversionAlreadyDone": false
      },
      "shared_onedriveforbusiness": {
        "connectionName": "shared-onedriveforbu-eaa3bce2-c58e-4fa1-81d0-d78a9fb4ad93",
        "source": "Embedded",
        "id": "/providers/Microsoft.PowerApps/apis/shared_onedriveforbusiness",
        "tier": "NotSpecified",
        "apiName": "onedriveforbusiness",
        "isProcessSimpleApiReferenceConversionAlreadyDone": false
      },
      "shared_excelonlinebusiness": {
        "connectionName": "shared-excelonlinebu-03886d99-1d8e-4b5b-95ce-105a8b6ca4eb",
        "source": "Embedded",
        "id": "/providers/Microsoft.PowerApps/apis/shared_excelonlinebusiness",
        "tier": "NotSpecified",
        "apiName": "excelonlinebusiness",
        "isProcessSimpleApiReferenceConversionAlreadyDone": false
      }
    },
    "flowFailureAlertSubscribed": false,
    "isManaged": false
  }
}