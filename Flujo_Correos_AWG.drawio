(más de 5 h sin avanzar)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#F59E0B;strokeWidth=2;shadow=1;fontSize=10;spacing=30;spacingTop=4;spacingBottom=4;fontFamily=Inter, Helvetica, Arial;fontColor=#2D2E3A;" vertex="1" parent="c6"><mxGeometry x="30" y="530" width="380" height="160" as="geometry"/></mxCell>
<mxCell id="p6_alert" value="Por cada uno: envía alerta a pgcustservw2.im@pg.com — &quot;[AWG CON] Flujo de consolidación atascado (+5h)&quot; con FlowId, fase, POs y asunto original" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3B82F6;strokeWidth=2;shadow=1;fontSize=11;spacing=8;fontFamily=Inter, Helvetica, Arial;fontColor=#2D2E3A;" vertex="1" parent="c6"><mxGeometry x="65" y="750" width="310" height="100" as="geometry"/></mxCell>
