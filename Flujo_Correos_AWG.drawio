<mxCell id="c4" value="FASE 04 · Respuesta de RDD y seguimiento" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FCF6E3;strokeColor=none;verticalAlign=top;align=left;spacingLeft=18;spacingTop=12;fontSize=16;fontStyle=1;fontFamily=Inter, Helvetica, Arial;fontColor=#A16207;" vertex="1" parent="1"><mxGeometry x="2880" y="110" width="650" height="1620" as="geometry"/></mxCell>
<mxCell id="p4_start" value="Llega un correo al buzón compartido pgcustservw2.im@pg.com, carpeta &quot;Marín, Cristhofer - AWG + Wakefern&quot; (se revisa cada 1 minuto)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#10B981;strokeWidth=2;shadow=1;fontSize=11;fontStyle=1;fontFamily=Inter, Helvetica, Arial;fontColor=#2D2E3A;" vertex="1" parent="c4"><mxGeometry x="90" y="60" width="240" height="95" as="geometry"/></mxCell>
<mxCell id="p4_data" value="¿Trae la tabla de datos de la IA? (contiene &quot;Customer Item #&quot;, &quot;Pom code&quot;, &quot;L3&quot; y &quot;Current RDD&quot;)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#F59E0B;strokeWidth=2;shadow=1;fontSize=10;fontFamily=Inter, Helvetica, Arial;fontColor=#2D2E3A;" vertex="1" parent="c4"><mxGeometry x="100" y="200" width="220" height="115" as="geometry"/></mxCell>
<mxCell id="p4_rdd" value="Extrae del cuerpo la nueva RDD alineada y calcula la fecha de trabajo = RDD − 10 días" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3B82F6;strokeWidth=2;shadow=1;fontSize=11;fontFamily=Inter, Helvetica, Arial;fontColor=#2D2E3A;" vertex="1" parent="c4"><mxGeometry x="70" y="365" width="280" height="70" as="geometry"/></mxCell>
<mxCell id="p4_find" value="¿Existe en SharePoint un registro para esta conversación en Fase 03-RDDRequestSent?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#F59E0B;strokeWidth=2;shadow=1;fontSize=10;fontFamily=Inter, Helvetica, Arial;fontColor=#2D2E3A;" vertex="1" parent="c4"><mxGeometry x="100" y="485" width="220" height="110" as="geometry"/></mxCell>
<mxCell id="p4_window" value="¿Hoy ya está dentro de la ventana de trabajo? (hoy ≥ RDD − 10 días)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#F59E0B;strokeWidth=2;shadow=1;fontSize=10;fontFamily=Inter, Helvetica, Arial;fontColor=#2D2E3A;" vertex="1" parent="c4"><mxGeometry x="100" y="645" width="220" height="105" as="geometry"/></mxCell>
<mxCell id="p4_ready" value="Actualiza el registro: Status &quot;Ready for OSS Follow Up&quot; (Fase: 05-FullTableRequestSent) y responde a la IA (ossgenai.im@pg.com) pidiendo la tabla completa de consolidación (PO, SO, Ship-to, RDD, Collective, Shipment, Delivery, Truck #)" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3B82F6;strokeWidth=2;shadow=1;fontSize=11;fontFamily=Inter, Helvetica, Arial;fontColor=#2D2E3A;" vertex="1" parent="c4"><mxGeometry x="70" y="800" width="280" height="120" as="geometry"/></mxCell>
<mxCell id="p4_cat" value="Etiqueta el correo con &quot;RPA&quot;, &quot;Follow up&quot;, &quot;Cristhofer Marín&quot; y lo mueve a &quot;AWG Complete&quot;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3B82F6;strokeWidth=2;shadow=1;fontSize=11;fontFamily=Inter, Helvetica, Arial;fontColor=#2D2E3A;" vertex="1" parent="c4"><mxGeometry x="70" y="970" width="280" height="75" as="geometry"/></mxCell>
<mxCell id="p4_end" value="Fin del flujo automatizado (el caso queda en seguimiento en SharePoint)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#EF4444;strokeWidth=2;shadow=1;fontSize=11;fontStyle=1;fontFamily=Inter, Helvetica, Arial;fontColor=#2D2E3A;" vertex="1" parent="c4"><mxGeometry x="90" y="1095" width="240" height="70" as="geometry"/></mxCell>
<mxCell id="p4_ignore" value="No aplica: se ignora" style="ellipse;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=2;shadow=1;fontSize=10;fontFamily=Inter, Helvetica, Arial;fontColor=#2D2E3A;fontColor=#64748B;" vertex="1" parent="c4"><mxGeometry x="430" y="230" width="150" height="55" as="geometry"/></mxCell>
<mxCell id="p4_cancel" value="Cancelado: no está en el flujo" style="ellipse;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=2;shadow=1;fontSize=10;fontFamily=Inter, Helvetica, Arial;fontColor=#2D2E3A;fontColor=#64748B;" vertex="1" parent="c4"><mxGeometry x="430" y="510" width="150" height="60" as="geometry"/></mxCell>
<mxCell id="p4_pending" value="Aún faltan más de 10 días: actualiza el registro a Status &quot;Pending 10 Days Out&quot; con la fecha de trabajo programada y responde a la IA avisando la fecha en que se trabajará" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#F97316;strokeWidth=2;shadow=1;fontSize=10;fontFamily=Inter, Helvetica, Arial;fontColor=#2D2E3A;" vertex="1" parent="c4"><mxGeometry x="420" y="655" width="190" height="140" as="geometry"/></mxCell>
