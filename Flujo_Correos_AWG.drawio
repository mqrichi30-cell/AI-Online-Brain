<mxCell id="c2" value="FASE 02 · Recibe la tabla Truck/PO y pide Ride-With" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#EBF2FC;strokeColor=none;verticalAlign=top;align=left;spacingLeft=18;spacingTop=12;fontSize=16;fontStyle=1;fontFamily=Inter, Helvetica, Arial;fontColor=#1D4ED8;" vertex="1" parent="1"><mxGeometry x="1460" y="110" width="650" height="1620" as="geometry"/></mxCell>
<mxCell id="p2_start" value="Llega un correo de ossgenai.im@pg.com a la carpeta:
Bandeja de entrada &gt; &quot;Marín, Cristhofer - AWG + Wakefern&quot; (buzón pgcustservw2.im@pg.com)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#10B981;strokeWidth=2;shadow=1;fontSize=11;fontStyle=1;fontFamily=Inter, Helvetica, Arial;fontColor=#2D2E3A;" vertex="1" parent="c2"><mxGeometry x="90" y="60" width="240" height="85" as="geometry"/></mxCell>
<mxCell id="p2_track" value="¿Existe en SharePoint un registro con ese FlowId en Fase 01-IntakeSent?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#F59E0B;strokeWidth=2;shadow=1;fontSize=10;fontFamily=Inter, Helvetica, Arial;fontColor=#2D2E3A;" vertex="1" parent="c2"><mxGeometry x="100" y="190" width="220" height="105" as="geometry"/></mxCell>
<mxCell id="p2_valid" value="¿La respuesta trae una tabla válida? (contiene &lt;table&gt;, &quot;truck&quot; y &quot;po&quot;; NO es &quot;Is not a consolidation&quot; ni una tabla de datos con &quot;Shipment Number&quot; / &quot;Delivery Number&quot; / &quot;SO #&quot;)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#F59E0B;strokeWidth=2;shadow=1;fontSize=10;fontFamily=Inter, Helvetica, Arial;fontColor=#2D2E3A;" vertex="1" parent="c2"><mxGeometry x="100" y="345" width="220" height="135" as="geometry"/></mxCell>
<mxCell id="p2_first" value="¿Es la primera vez que se procesa esta consolidación? (el hilo no contiene marcas de un proceso anterior)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#F59E0B;strokeWidth=2;shadow=1;fontSize=10;fontFamily=Inter, Helvetica, Arial;fontColor=#2D2E3A;" vertex="1" parent="c2"><mxGeometry x="100" y="530" width="220" height="115" as="geometry"/></mxCell>
<mxCell id="p2_pos" value="¿Se extrajeron 2 o más números de PO de la tabla?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#F59E0B;strokeWidth=2;shadow=1;fontSize=10;fontFamily=Inter, Helvetica, Arial;fontColor=#2D2E3A;" vertex="1" parent="c2"><mxGeometry x="100" y="695" width="220" height="100" as="geometry"/></mxCell>
<mxCell id="p2_ride" value="Redacta y envía el correo &quot;Ride-With&quot; en el mismo hilo del original, dirigido al buzón pgcustservw2.im@pg.com (Main PO + Riding-With POs)" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3B82F6;strokeWidth=2;shadow=1;fontSize=11;fontFamily=Inter, Helvetica, Arial;fontColor=#2D2E3A;" vertex="1" parent="c2"><mxGeometry x="70" y="845" width="280" height="90" as="geometry"/></mxCell>
<mxCell id="p2_adv" value="Guarda los PO/SO en SharePoint, avanza a Fase 02-ConsolTableRcvd y mueve la respuesta de la IA a &quot;AWG Complete&quot;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3B82F6;strokeWidth=2;shadow=1;fontSize=11;fontFamily=Inter, Helvetica, Arial;fontColor=#2D2E3A;" vertex="1" parent="c2"><mxGeometry x="70" y="985" width="280" height="80" as="geometry"/></mxCell>
<mxCell id="p2_end" value="El correo &quot;Ride-With&quot; dispara la  FASE 03" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#EF4444;strokeWidth=2;shadow=1;fontSize=11;fontStyle=1;fontFamily=Inter, Helvetica, Arial;fontColor=#2D2E3A;" vertex="1" parent="c2"><mxGeometry x="90" y="1115" width="240" height="60" as="geometry"/></mxCell>
<mxCell id="p2_cancel" value="Cancelado: no está en el flujo" style="ellipse;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=2;shadow=1;fontSize=10;fontFamily=Inter, Helvetica, Arial;fontColor=#2D2E3A;fontColor=#64748B;" vertex="1" parent="c2"><mxGeometry x="430" y="215" width="150" height="60" as="geometry"/></mxCell>
<mxCell id="p2_restore" value="Restaura el ORIGINAL a la carpeta raíz &quot;Marín, Cristhofer - AWG + Wakefern&quot; (no leído), marca la respuesta de la IA como leída, la mueve a &quot;AWG Complete&quot; y BORRA el registro de seguimiento" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#F97316;strokeWidth=2;shadow=1;fontSize=10;fontFamily=Inter, Helvetica, Arial;fontColor=#2D2E3A;" vertex="1" parent="c2"><mxGeometry x="420" y="360" width="190" height="150" as="geometry"/></mxCell>
