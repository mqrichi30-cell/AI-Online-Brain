<mxCell id="p0_reply" value="Responde el correo ORIGINAL (mismo hilo) a la IA ossgenai.im@pg.com pidiendo clasificarlo: Consolidation / Wakefern Appointments / No Match" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3B82F6;strokeWidth=2;shadow=1;fontSize=11;fontFamily=Inter, Helvetica, Arial;fontColor=#2D2E3A;" vertex="1" parent="c0"><mxGeometry x="70" y="1240" width="280" height="80" as="geometry"/></mxCell>
