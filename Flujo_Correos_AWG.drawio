<mxCell id="c4" value="FASE 04 · Respuesta de RDD y seguimiento" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FCF6E3;strokeColor=none;verticalAlign=top;align=left;spacingLeft=18;spacingTop=12;fontSize=15;fontStyle=1;fontFamily=Inter, Helvetica, Arial;fontColor=#A16207;" vertex="1" parent="1"><mxGeometry x="2960" y="110" width="660" height="1504" as="geometry"/></mxCell>
<mxCell id="p4_start" value="Llega un correo al buzón compartido pgcustservw2.im@pg.com (se revisa cada 1 minuto)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#10B981;strokeWidth=2;shadow=1;fontSize=11;fontStyle=1;spacing=8;fontFamily=Inter, Helvetica, Arial;fontColor=#2D2E3A;" vertex="1" parent="c4"><mxGeometry x="75" y="70" width="270" height="110" as="geometry"/></mxCell>
<mxCell id="p4_data" value="¿Trae la tabla de datos de la IA?
(&quot;Customer Item #&quot;, &quot;Pom code&quot;, &quot;L3&quot;, &quot;Current RDD&quot;)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#F59E0B;strokeWidth=2;shadow=1;fontSize=10;spacing=2;fontFamily=Inter, Helvetica, Arial;fontColor=#2D2E3A;" vertex="1" parent="c4"><mxGeometry x="45" y="238" width="330" height="160" as="geometry"/></mxCell>
<mxCell id="p4_rdd" value="Extrae la nueva RDD alineada y calcula la fecha de trabajo = RDD − 10 días" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3B82F6;strokeWidth=2;shadow=1;fontSize=11;spacing=6;fontFamily=Inter, Helvetica, Arial;fontColor=#2D2E3A;" vertex="1" parent="c4"><mxGeometry x="55" y="456" width="310" height="70" as="geometry"/></mxCell>
<mxCell id="p4_find" value="¿Hay registro de esta conversación en Fase 03-RDDRequestSent?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#F59E0B;strokeWidth=2;shadow=1;fontSize=10;spacing=2;fontFamily=Inter, Helvetica, Arial;fontColor=#2D2E3A;" vertex="1" parent="c4"><mxGeometry x="45" y="584" width="330" height="150" as="geometry"/></mxCell>
<mxCell id="p4_window" value="¿Hoy está dentro de la ventana de trabajo?
(hoy ≥ RDD − 10 días)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#F59E0B;strokeWidth=2;shadow=1;fontSize=10;spacing=2;fontFamily=Inter, Helvetica, Arial;fontColor=#2D2E3A;" vertex="1" parent="c4"><mxGeometry x="45" y="792" width="330" height="160" as="geometry"/></mxCell>
<mxCell id="p4_ready" value="Actualiza el registro: Status &quot;Ready for OSS Follow Up&quot; (Fase: 05-FullTableRequestSent) y pide a la IA la tabla completa de consolidación (PO, SO, Ship-to, RDD, Collective, Shipment, Delivery, Truck #)" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3B82F6;strokeWidth=2;shadow=1;fontSize=11;spacing=6;fontFamily=Inter, Helvetica, Arial;fontColor=#2D2E3A;" vertex="1" parent="c4"><mxGeometry x="55" y="1010" width="310" height="115" as="geometry"/></mxCell>
<mxCell id="p4_cat" value="Etiqueta el correo con &quot;RPA&quot;, &quot;Follow up&quot;, &quot;Cristhofer Marín&quot; y lo mueve a &quot;AWG Complete&quot;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3B82F6;strokeWidth=2;shadow=1;fontSize=11;spacing=6;fontFamily=Inter, Helvetica, Arial;fontColor=#2D2E3A;" vertex="1" parent="c4"><mxGeometry x="55" y="1183" width="310" height="75" as="geometry"/></mxCell>
<mxCell id="p4_end" value="FIN del flujo automatizado
