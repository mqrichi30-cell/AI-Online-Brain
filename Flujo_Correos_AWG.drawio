<mxCell id="c1" value="FASE 01 · Intake — lee la clasificación de la IA" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#EAF6EF;strokeColor=none;verticalAlign=top;align=left;spacingLeft=18;spacingTop=12;fontSize=16;fontStyle=1;fontFamily=Inter, Helvetica, Arial;fontColor=#047857;" vertex="1" parent="1"><mxGeometry x="750" y="110" width="650" height="1620" as="geometry"/></mxCell>
<mxCell id="p1_start" value="Llega un correo a la carpeta:
Bandeja de entrada &gt; &quot;Marín, Cristhofer - AWG + Wakefern&quot; (buzón pgcustservw2.im@pg.com)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#10B981;strokeWidth=2;shadow=1;fontSize=11;fontStyle=1;fontFamily=Inter, Helvetica, Arial;fontColor=#2D2E3A;" vertex="1" parent="c1"><mxGeometry x="90" y="60" width="240" height="80" as="geometry"/></mxCell>
<mxCell id="p1_sender" value="¿El remitente es la IA (ossgenai.im@pg.com)?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#F59E0B;strokeWidth=2;shadow=1;fontSize=10;fontFamily=Inter, Helvetica, Arial;fontColor=#2D2E3A;" vertex="1" parent="c1"><mxGeometry x="100" y="185" width="220" height="95" as="geometry"/></mxCell>
<mxCell id="p1_parse" value="Lee del cuerpo el FlowId (marca oculta AWG-FLOW-ID) y el resultado: Consolidation / Wakefern Appointments / No Match" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3B82F6;strokeWidth=2;shadow=1;fontSize=11;fontFamily=Inter, Helvetica, Arial;fontColor=#2D2E3A;" vertex="1" parent="c1"><mxGeometry x="70" y="330" width="280" height="80" as="geometry"/></mxCell>
<mxCell id="p1_find" value="¿Encuentra en SharePoint el registro con ese FlowId en Fase 00-RouterSent?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#F59E0B;strokeWidth=2;shadow=1;fontSize=10;fontFamily=Inter, Helvetica, Arial;fontColor=#2D2E3A;" vertex="1" parent="c1"><mxGeometry x="100" y="460" width="220" height="110" as="geometry"/></mxCell>
<mxCell id="p1_update" value="Actualiza el registro con la clasificación (Fase: 00-RouterClassified)" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3B82F6;strokeWidth=2;shadow=1;fontSize=11;fontFamily=Inter, Helvetica, Arial;fontColor=#2D2E3A;" vertex="1" parent="c1"><mxGeometry x="70" y="620" width="280" height="65" as="geometry"/></mxCell>
<mxCell id="p1_type" value="¿La clasificación es &quot;Consolidation&quot;?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#F59E0B;strokeWidth=2;shadow=1;fontSize=10;fontFamily=Inter, Helvetica, Arial;fontColor=#2D2E3A;" vertex="1" parent="c1"><mxGeometry x="100" y="735" width="220" height="95" as="geometry"/></mxCell>
<mxCell id="p1_consol" value="Marca el correo original con &quot;RPA&quot; + &quot;Follow up&quot; (no leído) y lo mueve a la subcarpeta &quot;AWG Complete &gt; AWG - CON - 01&quot;; la respuesta de la IA también va a &quot;AWG - CON - 01&quot;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3B82F6;strokeWidth=2;shadow=1;fontSize=11;fontFamily=Inter, Helvetica, Arial;fontColor=#2D2E3A;" vertex="1" parent="c1"><mxGeometry x="70" y="885" width="280" height="95" as="geometry"/></mxCell>
<mxCell id="p1_asktable" value="Responde a la IA (ossgenai.im@pg.com) en el mismo hilo pidiendo la tabla Truck # / PO # (Fase: 01-IntakeSent)" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3B82F6;strokeWidth=2;shadow=1;fontSize=11;fontFamily=Inter, Helvetica, Arial;fontColor=#2D2E3A;" vertex="1" parent="c1"><mxGeometry x="70" y="1030" width="280" height="80" as="geometry"/></mxCell>
<mxCell id="p1_end" value="Espera la tabla de la IA  →  FASE 02" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#EF4444;strokeWidth=2;shadow=1;fontSize=11;fontStyle=1;fontFamily=Inter, Helvetica, Arial;fontColor=#2D2E3A;" vertex="1" parent="c1"><mxGeometry x="90" y="1160" width="240" height="60" as="geometry"/></mxCell>
<mxCell id="p1_ignore" value="No es de la IA: se ignora" style="ellipse;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=2;shadow=1;fontSize=10;fontFamily=Inter, Helvetica, Arial;fontColor=#2D2E3A;fontColor=#64748B;" vertex="1" parent="c1"><mxGeometry x="430" y="210" width="150" height="55" as="geometry"/></mxCell>
<mxCell id="p1_fallback" value="Sin registro (fallback): busca el original en &quot;GENERAL - Email Route - 00&quot;, raíz del cliente y &quot;AWG Complete&quot;; lo restaura y archiva la respuesta de la IA en &quot;AWG - CON - 01&quot;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#F97316;strokeWidth=2;shadow=1;fontSize=10;fontFamily=Inter, Helvetica, Arial;fontColor=#2D2E3A;" vertex="1" parent="c1"><mxGeometry x="420" y="460" width="190" height="130" as="geometry"/></mxCell>
<mxCell id="p1_return" value="NO consolidación: devuelve el ORIGINAL a la carpeta raíz &quot;Marín, Cristhofer - AWG + Wakefern&quot; como NO leído y sin categorías; la respuesta de la IA se marca leída y va a &quot;AWG - CON - 01&quot;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#F97316;strokeWidth=2;shadow=1;fontSize=10;fontFamily=Inter, Helvetica, Arial;fontColor=#2D2E3A;" vertex="1" parent="c1"><mxGeometry x="420" y="730" width="190" height="140" as="geometry"/></mxCell>
