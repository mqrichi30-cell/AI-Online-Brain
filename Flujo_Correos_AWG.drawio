<mxCell id="p2_dupend" value="Ya procesada antes: se omite" style="ellipse;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=2;shadow=1;fontSize=10;fontFamily=Inter, Helvetica, Arial;fontColor=#2D2E3A;fontColor=#64748B;" vertex="1" parent="c2"><mxGeometry x="430" y="620" width="150" height="60" as="geometry"/></mxCell>
