<mxCell id="p0_start" value="Entra un correo NUEVO a la carpeta:
Bandeja de entrada &gt; &quot;Marín, Cristhofer - AWG + Wakefern&quot; (buzón pgcustservw2.im@pg.com)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#10B981;strokeWidth=2;shadow=1;fontSize=11;fontStyle=1;fontFamily=Inter, Helvetica, Arial;fontColor=#2D2E3A;" vertex="1" parent="c0"><mxGeometry x="90" y="60" width="240" height="80" as="geometry"/></mxCell>
<mxCell id="p0_trig" value="¿El remitente NO es ossgenai.im@pg.com ni nacsoshared.im@pg.com, el asunto NO trae &quot;AWG-FLOW-ID:&quot; ni &quot;AWG-STEP:&quot; y NO tiene categoría &quot;No Match&quot;?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#F59E0B;strokeWidth=2;shadow=1;fontSize=10;fontFamily=Inter, Helvetica, Arial;fontColor=#2D2E3A;" vertex="1" parent="c0"><mxGeometry x="100" y="185" width="220" height="120" as="geometry"/></mxCell>
