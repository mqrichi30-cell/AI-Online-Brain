<mxCell id="p0_ai" value="¿Es correo de IA / sistema / Wakefern? (menciona wakefern, ossgenai.im@pg.com, &quot;final state results&quot;, &quot;system-generated email&quot;, etc.)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#F59E0B;strokeWidth=2;shadow=1;fontSize=10;fontFamily=Inter, Helvetica, Arial;fontColor=#2D2E3A;" vertex="1" parent="c0"><mxGeometry x="100" y="510" width="220" height="120" as="geometry"/></mxCell>
