<mxCell id="c3" value="FASE 03 · Ride-With — arma el MOC y pide alinear la RDD" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FDF1E7;strokeColor=none;verticalAlign=top;align=left;spacingLeft=18;spacingTop=12;fontSize=16;fontStyle=1;fontFamily=Inter, Helvetica, Arial;fontColor=#C2410C;" vertex="1" parent="1"><mxGeometry x="2170" y="110" width="650" height="1620" as="geometry"/></mxCell>
<mxCell id="p3_start" value="Llega un correo al buzón compartido pgcustservw2.im@pg.com, carpeta &quot;Marín, Cristhofer - AWG + Wakefern&quot; (se revisa cada 1 minuto)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#10B981;strokeWidth=2;shadow=1;fontSize=11;fontStyle=1;fontFamily=Inter, Helvetica, Arial;fontColor=#2D2E3A;" vertex="1" parent="c3"><mxGeometry x="90" y="60" width="240" height="95" as="geometry"/></mxCell>
<mxCell id="p3_ride" value="¿El cuerpo es una notificación Ride-With? (&quot;scheduled to ride with another load&quot; o &quot;will ride together for delivery&quot;) y NO contiene &quot;final state results&quot; ni &quot;delivery number&quot;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#F59E0B;strokeWidth=2;shadow=1;fontSize=10;fontFamily=Inter, Helvetica, Arial;fontColor=#2D2E3A;" vertex="1" parent="c3"><mxGeometry x="100" y="200" width="220" height="135" as="geometry"/></mxCell>
<mxCell id="p3_guard" value="¿El FlowId aún NO fue procesado en esta fase? (no existe registro en Fase 02-ConsolTableRcvd ya consumido)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#F59E0B;strokeWidth=2;shadow=1;fontSize=10;fontFamily=Inter, Helvetica, Arial;fontColor=#2D2E3A;" vertex="1" parent="c3"><mxGeometry x="100" y="385" width="220" height="115" as="geometry"/></mxCell>
<mxCell id="p3_extract" value="Extrae el PO principal (&quot;Main PO Number&quot;) y los PO que viajan con él (&quot;Riding With POs&quot;)" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3B82F6;strokeWidth=2;shadow=1;fontSize=11;fontFamily=Inter, Helvetica, Arial;fontColor=#2D2E3A;" vertex="1" parent="c3"><mxGeometry x="70" y="550" width="280" height="75" as="geometry"/></mxCell>
<mxCell id="p3_moc" value="Llena la plantilla MOC.xlsx con la lista de PO (Office Script sobre SharePoint NACSO-RegionalVMI &gt; /General/Customer Documents/AWG-VMC/MOC.xlsx)" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3B82F6;strokeWidth=2;shadow=1;fontSize=11;fontFamily=Inter, Helvetica, Arial;fontColor=#2D2E3A;" vertex="1" parent="c3"><mxGeometry x="70" y="675" width="280" height="90" as="geometry"/></mxCell>
<mxCell id="p3_send" value="Crea y envía un correo nuevo &quot;Awg Consolidation Request&quot; con MOC.xlsx adjunto a nacsoshared.im@pg.com" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3B82F6;strokeWidth=2;shadow=1;fontSize=11;fontFamily=Inter, Helvetica, Arial;fontColor=#2D2E3A;" vertex="1" parent="c3"><mxGeometry x="70" y="815" width="280" height="80" as="geometry"/></mxCell>
<mxCell id="p3_rdd" value="Responde en el hilo a la IA (ossgenai.im@pg.com) pidiendo alinear todos los PO a la última RDD con POM CODE L3 (ProcessType: AWG_RDD_ALIGNMENT)" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3B82F6;strokeWidth=2;shadow=1;fontSize=11;fontFamily=Inter, Helvetica, Arial;fontColor=#2D2E3A;" vertex="1" parent="c3"><mxGeometry x="70" y="945" width="280" height="90" as="geometry"/></mxCell>
<mxCell id="p3_adv" value="Avanza el registro de SharePoint a Fase 03-RDDRequestSent" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3B82F6;strokeWidth=2;shadow=1;fontSize=11;fontFamily=Inter, Helvetica, Arial;fontColor=#2D2E3A;" vertex="1" parent="c3"><mxGeometry x="70" y="1085" width="280" height="65" as="geometry"/></mxCell>
<mxCell id="p3_arch" value="Mueve el correo Ride-With a &quot;AWG Complete&quot; y lo marca como leído (luego espera 1 hora)" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3B82F6;strokeWidth=2;shadow=1;fontSize=11;fontFamily=Inter, Helvetica, Arial;fontColor=#2D2E3A;" vertex="1" parent="c3"><mxGeometry x="70" y="1200" width="280" height="75" as="geometry"/></mxCell>
<mxCell id="p3_end" value="Espera la respuesta de la IA  →  FASE 04" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#EF4444;strokeWidth=2;shadow=1;fontSize=11;fontStyle=1;fontFamily=Inter, Helvetica, Arial;fontColor=#2D2E3A;" vertex="1" parent="c3"><mxGeometry x="90" y="1325" width="240" height="60" as="geometry"/></mxCell>
<mxCell id="p3_ignore" value="No aplica: se ignora" style="ellipse;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=2;shadow=1;fontSize=10;fontFamily=Inter, Helvetica, Arial;fontColor=#2D2E3A;fontColor=#64748B;" vertex="1" parent="c3"><mxGeometry x="430" y="245" width="150" height="55" as="geometry"/></mxCell>
