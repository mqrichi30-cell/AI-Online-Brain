{
  "properties": {
    "connectionReferences": {
      "shared_office365": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "awg_sharedoffice365_37d40"
        },
        "api": {
          "name": "shared_office365"
        }
      },
      "shared_sharepointonline": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "awg_sharedsharepointonline_6e67f"
        },
        "api": {
          "name": "shared_sharepointonline"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        }
      },
      "triggers": {
        "When_a_new_email_arrives_(V3)": {
          "splitOn": "@triggerOutputs()?['body/value']",
          "metadata": {
            "Id::AAMkAGMzNjc1ZDRmLTFlOTktNGQzNS04NTVmLTkwMDVkOWEyYmY0MQAuAAAAAACUFGw_S0XqRK5id50_416QAQCJMa30OofZSrcZSkuH_Y6QAAYFina4AAA=": "Marín, Cristhofer - AWG + Wakefern"
          },
          "type": "OpenApiConnectionNotification",
          "inputs": {
            "parameters": {
              "from": "ossgenai.im@pg.com",
              "includeAttachments": false,
              "fetchOnlyWithAttachment": false,
              "folderPath": "Id::AAMkAGMzNjc1ZDRmLTFlOTktNGQzNS04NTVmLTkwMDVkOWEyYmY0MQAuAAAAAACUFGw_S0XqRK5id50_416QAQCJMa30OofZSrcZSkuH_Y6QAAYFina4AAA="
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
              "operationId": "OnNewEmailV3",
              "connectionName": "shared_office365"
            }
          }
        }
      },
      "actions": {
        "Initialize_SignatureHtml": {
          "runAfter": {},
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "SignatureHtml",
                "type": "string",
                "value": "<br>Regards,<br><table cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"border-collapse:collapse;\"><tr><td style=\"padding:0 14px 0 0;vertical-align:middle;\"><img src=\"data:image/png;base64,\" width=\"120\" height=\"61\" alt=\"P&amp;G\" style=\"display:block;border:0;\" /></td><td style=\"vertical-align:middle;font-family:Calibri,Arial,sans-serif;font-size:11pt;line-height:16pt;color:#000000;\">Cristhofer Mar&iacute;n Quir&oacute;s<br>pgcustservw2.im@pg.com<br>F&amp;A | NA Order Management Analyst | Regional Sales to Cash</td></tr></table><br>"
              }
            ]
          }
        },
        "Compose_FlowId_From_Body": {
          "runAfter": {
            "Initialize_SignatureHtml": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "@if(contains(coalesce(triggerOutputs()?['body/body'], ''), 'AWG-FLOW-ID:'), trim(first(split(first(split(replace(replace(replace(last(split(coalesce(triggerOutputs()?['body/body'], ''), 'AWG-FLOW-ID:')), '&nbsp;', ' '), '&#160;', ' '), '</', '<'), '<')), '|'))), '')"
        },
        "AWG_-_CON_-_02_Get_Tracking_Item": {
          "runAfter": {
            "Compose_FlowId_From_Body": [
              "Succeeded"
            ]
          },
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "dataset": "https://pgone.sharepoint.com/sites/NACSO-RegionalVMI",
              "table": "70ed8abc-c524-4142-9d8a-86f70ced426c",
              "$filter": "FlowId eq '@{outputs('Compose_FlowId_From_Body')}' and Phase eq '01-IntakeSent'",
              "$top": 1
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "operationId": "GetItems",
              "connectionName": "shared_sharepointonline"
            }
          }
        },
        "AWG_-_CON_-_02_Guard_Not_In_Flow": {
          "actions": {},
          "runAfter": {
            "AWG_-_CON_-_02_Get_Tracking_Item": [
              "Succeeded"
            ]
          },
          "else": {
            "actions": {
              "Terminate_Not_Tracked": {
                "type": "Terminate",
                "inputs": {
                  "runStatus": "Cancelled"
                }
              }
            }
          },
          "expression": {
            "and": [
              {
                "greater": [
                  "@length(body('AWG_-_CON_-_02_Get_Tracking_Item')?['value'])",
                  0
                ]
              }
            ]
          },
          "type": "If"
        },
        "Initialize_variable_-_TrucksArray": {
          "runAfter": {
            "AWG_-_CON_-_02_Guard_Not_In_Flow": [
              "Succeeded"
            ]
          },
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "varTrucksArray",
                "type": "array",
                "value": []
              }
            ]
          }
        },
        "AWG_-_CON_-_02_Get_Client_Folder": {
          "runAfter": {
            "Initialize_variable_-_TrucksArray": [
              "Succeeded"
            ]
          },
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "Uri": "https://graph.microsoft.com/v1.0/me/mailFolders/inbox/childFolders?$filter=displayName%20eq%20%27Mar%C3%ADn%2C%20Cristhofer%20-%20AWG%20%2B%20Wakefern%27&$top=1",
              "Method": "GET"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
              "operationId": "HttpRequest",
              "connectionName": "shared_office365"
            }
          }
        },
        "AWG_-_CON_-_02_Target_Client_Folder_Id": {
          "runAfter": {
            "AWG_-_CON_-_02_Get_Client_Folder": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "@first(body('AWG_-_CON_-_02_Get_Client_Folder')?['value'])?['id']"
        },
        "AWG_-_CON_-_02_Get_AWG_Complete_Folder": {
          "runAfter": {
            "AWG_-_CON_-_02_Target_Client_Folder_Id": [
              "Succeeded"
            ]
          },
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "Uri": "@concat('https://graph.microsoft.com/v1.0/me/mailFolders/', encodeUriComponent(outputs('AWG_-_CON_-_02_Target_Client_Folder_Id')), '/childFolders?$filter=displayName%20eq%20%27AWG%20Complete%27&$top=1')",
              "Method": "GET"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
              "operationId": "HttpRequest",
              "connectionName": "shared_office365"
            }
          }
        },
        "AWG_-_CON_-_02_Target_AWG_Complete_Folder_Id": {
          "runAfter": {
            "AWG_-_CON_-_02_Get_AWG_Complete_Folder": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "@first(body('AWG_-_CON_-_02_Get_AWG_Complete_Folder')?['value'])?['id']"
        },
        "AWG_-_CON_-_02_Get_AWG_CON_01_Folder": {
          "runAfter": {
            "AWG_-_CON_-_02_Target_AWG_Complete_Folder_Id": [
              "Succeeded"
            ]
          },
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "Uri": "@concat('https://graph.microsoft.com/v1.0/me/mailFolders/', encodeUriComponent(outputs('AWG_-_CON_-_02_Target_AWG_Complete_Folder_Id')), '/childFolders?$filter=displayName%20eq%20%27AWG%20-%20CON%20-%2001%27&$top=1')",
              "Method": "GET"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
              "operationId": "HttpRequest",
              "connectionName": "shared_office365"
            }
          }
        },
        "AWG_-_CON_-_02_Target_AWG_CON_01_Folder_Id": {
          "runAfter": {
            "AWG_-_CON_-_02_Get_AWG_CON_01_Folder": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "@first(body('AWG_-_CON_-_02_Get_AWG_CON_01_Folder')?['value'])?['id']"
        },
        "AWG_-_CON_-_02_Get_AWG_CON_02_Folder": {
          "runAfter": {
            "AWG_-_CON_-_02_Target_AWG_CON_01_Folder_Id": [
              "Succeeded"
            ]
          },
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "Uri": "@concat('https://graph.microsoft.com/v1.0/me/mailFolders/', encodeUriComponent(outputs('AWG_-_CON_-_02_Target_AWG_Complete_Folder_Id')), '/childFolders?$filter=displayName%20eq%20%27AWG%20-%20CON%20-%2002%27&$top=1')",
              "Method": "GET"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
              "operationId": "HttpRequest",
              "connectionName": "shared_office365"
            }
          }
        },
        "AWG_-_CON_-_02_Target_AWG_CON_02_Folder_Id": {
          "runAfter": {
            "AWG_-_CON_-_02_Get_AWG_CON_02_Folder": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "@first(body('AWG_-_CON_-_02_Get_AWG_CON_02_Folder')?['value'])?['id']"
        },
        "AWG_-_CON_-_02_HTTP_List_AWGCON01_Messages": {
          "runAfter": {
            "AWG_-_CON_-_02_Target_AWG_CON_02_Folder_Id": [
              "Succeeded"
            ]
          },
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "Uri": "@concat('https://graph.microsoft.com/v1.0/me/mailFolders/', encodeUriComponent(outputs('AWG_-_CON_-_02_Target_AWG_CON_01_Folder_Id')), '/messages?$top=100&$select=id,subject,from,conversationId,parentFolderId,receivedDateTime')",
              "Method": "GET",
              "CustomHeader1": "Prefer: IdType=\"ImmutableId\"",
              "ContentType": "application/json"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
              "operationId": "HttpRequest",
              "connectionName": "shared_office365"
            }
          }
        },
        "AWG_-_CON_-_02_HTTP_List_AWGCON02_Messages": {
          "runAfter": {
            "AWG_-_CON_-_02_HTTP_List_AWGCON01_Messages": [
              "Succeeded"
            ]
          },
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "Uri": "@concat('https://graph.microsoft.com/v1.0/me/mailFolders/', encodeUriComponent(outputs('AWG_-_CON_-_02_Target_AWG_CON_02_Folder_Id')), '/messages?$top=100&$select=id,subject,from,conversationId,parentFolderId,receivedDateTime')",
              "Method": "GET",
              "CustomHeader1": "Prefer: IdType=\"ImmutableId\"",
              "ContentType": "application/json"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
              "operationId": "HttpRequest",
              "connectionName": "shared_office365"
            }
          }
        },
        "AWG_-_CON_-_02_Filter_Current_OSS": {
          "runAfter": {
            "AWG_-_CON_-_02_HTTP_List_AWGCON02_Messages": [
              "Succeeded"
            ]
          },
          "type": "Query",
          "inputs": {
            "from": "@union(body('AWG_-_CON_-_02_HTTP_List_AWGCON01_Messages')?['value'], body('AWG_-_CON_-_02_HTTP_List_AWGCON02_Messages')?['value'])",
            "where": "@and(equals(item()?['conversationId'], triggerOutputs()?['body/conversationId']), equals(toLower(item()?['from']?['emailAddress']?['address']), 'ossgenai.im@pg.com'))"
          }
        },
        "AWG_-_CON_-_02_Compose_Resolved_Current_OSS_Immutable_ID": {
          "runAfter": {
            "AWG_-_CON_-_02_Filter_Current_OSS": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "@if(greater(length(body('AWG_-_CON_-_02_Filter_Current_OSS')), 0), first(body('AWG_-_CON_-_02_Filter_Current_OSS'))?['id'], coalesce(triggerOutputs()?['body/id'],''))"
        },
        "Compose_NormalizedBody": {
          "runAfter": {
            "AWG_-_CON_-_02_Compose_Resolved_Current_OSS_Immutable_ID": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "@toLower(replace(replace(replace(coalesce(triggerOutputs()?['body/body'], ''), '&lt;', '<'), '&gt;', '>'), '&quot;', '\"'))"
        },
        "Compose_CurrentEmailOnly": {
          "runAfter": {
            "Compose_NormalizedBody": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "@first(split(outputs('Compose_NormalizedBody'), '<div id=\"divrplyfwdmsg\"'))"
        },
        "Compose_HasPreviousConsolidationCheck": {
          "runAfter": {
            "Compose_CurrentEmailOnly": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "@or(contains(outputs('Compose_CurrentEmailOnly'), 'Confirm if this email is a consolidation request'), contains(outputs('Compose_CurrentEmailOnly'), 'Is not a consolidation'), contains(outputs('Compose_CurrentEmailOnly'), 'scheduled to ride with another load'), contains(outputs('Compose_CurrentEmailOnly'), 'AWG_CONSOLIDATION_REQUEST'))"
        },
        "MainConditio": {
          "actions": {
            "CheckAlreadyProcessedConsolidation": {
              "actions": {
                "Extract_Formatted_Table_Section": {
                  "type": "Compose",
                  "inputs": "@first(split(last(split(outputs('Compose_CurrentEmailOnly'), 'formatted table')), '</table>'))"
                },
                "Extract_Table_Rows": {
                  "runAfter": {
                    "Extract_Formatted_Table_Section": [
                      "Succeeded"
                    ]
                  },
                  "type": "Compose",
                  "inputs": "@skip(split(outputs('Extract_Formatted_Table_Section'), '<tr'), 2)"
                },
                "Apply_to_each_TableRow": {
                  "foreach": "@outputs('Extract_Table_Rows')",
                  "actions": {
                    "Compose_Truck_From_Row": {
                      "type": "Compose",
                      "inputs": "@trim(replace(replace(first(split(last(split(first(split(item(), '</td>')), '>')), '<')), 'truck', ''), '#', ''))"
                    },
                    "Compose_PO_From_Row": {
                      "runAfter": {
                        "Compose_Truck_From_Row": [
                          "Succeeded"
                        ]
                      },
                      "type": "Compose",
                      "inputs": "@trim(first(split(last(split(first(skip(split(item(), '</td>'), 1)), '>')), '<')))"
                    },
                    "Append_to_TrucksArray": {
                      "runAfter": {
                        "Compose_SoldTo_From_Row": [
                          "Succeeded"
                        ]
                      },
                      "type": "AppendToArrayVariable",
                      "inputs": {
                        "name": "varTrucksArray",
                        "value": {
                          "truck": "@outputs('Compose_Truck_From_Row')",
                          "po": "@outputs('Compose_PO_From_Row')",
                          "soldto": "@outputs('Compose_SoldTo_From_Row')"
                        }
                      }
                    },
                    "Compose_SoldTo_From_Row": {
                      "runAfter": {
                        "Compose_PO_From_Row": [
                          "Succeeded"
                        ]
                      },
                      "type": "Compose",
                      "inputs": "@trim(first(split(last(split(first(skip(split(item(), '</td>'), 2)), '>')), '<')))"
                    }
                  },
                  "runAfter": {
                    "Extract_Table_Rows": [
                      "Succeeded"
                    ]
                  },
                  "type": "Foreach"
                },
                "Select_Distinct_Trucks": {
                  "runAfter": {
                    "Apply_to_each_TableRow": [
                      "Succeeded"
                    ]
                  },
                  "type": "Select",
                  "inputs": {
                    "from": "@variables('varTrucksArray')",
                    "select": "@item()['truck']"
                  }
                },
                "Compose_Distinct_Truck_List": {
                  "runAfter": {
                    "Select_Distinct_Trucks": [
                      "Succeeded"
                    ]
                  },
                  "type": "Compose",
                  "inputs": "@union(body('Select_Distinct_Trucks'), body('Select_Distinct_Trucks'))"
                },
                "Check_Any_Valid_Truck": {
                  "actions": {
                    "Apply_to_each_Truck": {
                      "foreach": "@outputs('Compose_Distinct_Truck_List')",
                      "actions": {
                        "Filter_POs_For_Truck": {
                          "type": "Query",
                          "inputs": {
                            "from": "@variables('varTrucksArray')",
                            "where": "@equals(item()?['truck'], items('Apply_to_each_Truck'))"
                          }
                        },
                        "Check_Truck_Has_Multiple_POs": {
                          "actions": {
                            "Select_POs_Only": {
                              "type": "Select",
                              "inputs": {
                                "from": "@body('Filter_POs_For_Truck')",
                                "select": "@item()['po']"
                              }
                            },
                            "Compose_Truck_FlowId": {
                              "runAfter": {
                                "Select_POs_Only": [
                                  "Succeeded"
                                ]
                              },
                              "type": "Compose",
                              "inputs": "@concat(outputs('Compose_FlowId_From_Body'), '-T', items('Apply_to_each_Truck'))"
                            },
                            "Compose_Truck_POs_Joined": {
                              "runAfter": {
                                "Compose_Truck_FlowId": [
                                  "Succeeded"
                                ]
                              },
                              "type": "Compose",
                              "inputs": "@join(body('Select_POs_Only'), ',')"
                            },
                            "Create_Child_Tracking_Item": {
                              "runAfter": {
                                "Compose_Truck_SoldTo": [
                                  "Succeeded"
                                ]
                              },
                              "type": "OpenApiConnection",
                              "inputs": {
                                "parameters": {
                                  "dataset": "https://pgone.sharepoint.com/sites/NACSO-RegionalVMI",
                                  "table": "70ed8abc-c524-4142-9d8a-86f70ced426c",
                                  "item/Title": "@concat('AWG-CON-02-', outputs('Compose_Truck_FlowId'))",
                                  "item/OriginalMessageId": "@coalesce(first(body('AWG_-_CON_-_02_Get_Tracking_Item')?['value'])?['OriginalMessageId'], '')",
                                  "item/OriginalConversationId": "@coalesce(first(body('AWG_-_CON_-_02_Get_Tracking_Item')?['value'])?['OriginalConversationId'], triggerOutputs()?['body/conversationId'])",
                                  "item/POs": "@outputs('Compose_Truck_POs_Joined')",
                                  "item/OriginalSubject": "@coalesce(first(body('AWG_-_CON_-_02_Get_Tracking_Item')?['value'])?['OriginalSubject'], triggerOutputs()?['body/subject'])",
                                  "item/Status": "Consolidation",
                                  "item/FlowId": "@outputs('Compose_Truck_FlowId')",
                                  "item/Phase": "02-ConsolTableRcvd",
                                  "item/PhaseSince": "@utcNow()",
                                  "item/ParentFlowId": "@outputs('Compose_FlowId_From_Body')",
                                  "item/Customer": "@outputs('Compose_Truck_SoldTo')"
                                },
                                "host": {
                                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                                  "operationId": "PostItem",
                                  "connectionName": "shared_sharepointonline"
                                }
                              }
                            },
                            "Compose_Truck_Reply_HTML": {
                              "runAfter": {
                                "Create_Child_Tracking_Item": [
                                  "Succeeded"
                                ]
                              },
                              "type": "Compose",
                              "inputs": "@concat('<div><p>P&amp;G Team,</p>', '<p>This is an automatic notification that the following Purchase Order(s) are scheduled to ride with another load:</p>', '<ul>', '<li><strong>Main PO Number (The load):</strong> ', first(body('Select_POs_Only')), '</li>', '<li><strong>Riding With PO(s) (The load/s it is attached to):</strong> ', join(skip(body('Select_POs_Only'),1), ', '), '</li>', '<li><strong>Ship-to Location:</strong> N/A</li>', '</ul>', '<p>Please ensure that PO #', first(body('Select_POs_Only')), ' is consolidated with the load for PO(s) #', join(skip(body('Select_POs_Only'),1), ', '), '.</p>', variables('SignatureHtml'), '<p style=\"font-size:1px;color:#ffffff;line-height:1px\">AWG-FLOW-ID: ', outputs('Compose_Truck_FlowId'), ' | AWG-STEP: RIDE_WITH_REQUEST | AWG-CUSTOMER: ', outputs('Compose_Truck_SoldTo'), '</p>', '</div>')"
                            },
                            "Send_Truck_Email": {
                              "runAfter": {
                                "Compose_Truck_Reply_HTML": [
                                  "Succeeded"
                                ]
                              },
                              "type": "OpenApiConnection",
                              "inputs": {
                                "parameters": {
                                  "emailMessage/To": "pgcustservw2.im@pg.com",
                                  "emailMessage/Subject": "@concat(triggerOutputs()?['body/subject'], ' - T', items('Apply_to_each_Truck'))",
                                  "emailMessage/Body": "@outputs('Compose_Truck_Reply_HTML')",
                                  "emailMessage/Importance": "Normal"
                                },
                                "host": {
                                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
                                  "operationId": "SendEmailV2",
                                  "connectionName": "shared_office365"
                                }
                              }
                            },
                            "Compose_Truck_SoldTo": {
                              "runAfter": {
                                "Compose_Truck_POs_Joined": [
                                  "Succeeded"
                                ]
                              },
                              "type": "Compose",
                              "inputs": "@trim(coalesce(first(body('Filter_POs_For_Truck'))?['soldto'],''))"
                            }
                          },
                          "runAfter": {
                            "Filter_POs_For_Truck": [
                              "Succeeded"
                            ]
                          },
                          "else": {
                            "actions": {
                              "DEBUG_Truck_Ignored": {
                                "type": "Compose",
                                "inputs": "@concat('Truck ', items('Apply_to_each_Truck'), ' ignored (only 1 PO).')"
                              }
                            }
                          },
                          "expression": {
                            "and": [
                              {
                                "greaterOrEquals": [
                                  "@length(body('Filter_POs_For_Truck'))",
                                  2
                                ]
                              }
                            ]
                          },
                          "type": "If"
                        }
                      },
                      "type": "Foreach"
                    },
                    "AWG_-_CON_-_02_Advance_Parent_Phase": {
                      "runAfter": {
                        "Apply_to_each_Truck": [
                          "Succeeded"
                        ]
                      },
                      "type": "OpenApiConnection",
                      "inputs": {
                        "parameters": {
                          "dataset": "https://pgone.sharepoint.com/sites/NACSO-RegionalVMI",
                          "table": "70ed8abc-c524-4142-9d8a-86f70ced426c",
                          "id": "@first(body('AWG_-_CON_-_02_Get_Tracking_Item')?['value'])?['ID']",
                          "item/FlowId": "@outputs('Compose_FlowId_From_Body')",
                          "item/Phase": "02-ExpandedIntoTrucks",
                          "item/PhaseSince": "@utcNow()",
                          "item/Customer": "@trim(coalesce(first(variables('varTrucksArray'))?['soldto'],''))"
                        },
                        "host": {
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                          "operationId": "PatchItem",
                          "connectionName": "shared_sharepointonline"
                        }
                      }
                    },
                    "AWG_-_CON_-_02_Move_Trigger_Email_to_AWG_CON_02": {
                      "runAfter": {
                        "AWG_-_CON_-_02_Advance_Parent_Phase": [
                          "Succeeded"
                        ]
                      },
                      "type": "OpenApiConnection",
