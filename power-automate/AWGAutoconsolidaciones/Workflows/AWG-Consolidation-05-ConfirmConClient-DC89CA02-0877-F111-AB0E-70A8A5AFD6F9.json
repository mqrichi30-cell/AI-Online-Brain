{
  "properties": {
    "connectionReferences": {
      "shared_office365": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "awg_sharedoffice365_37d40"
        },
        "api": {
          "name": "shared_office365"
        }
      },
      "shared_sharepointonline": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "awg_sharedsharepointonline_6e67f"
        },
        "api": {
          "name": "shared_sharepointonline"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        }
      },
      "triggers": {
        "When_a_new_email_arrives_(V3)": {
          "splitOn": "@triggerOutputs()?['body/value']",
          "metadata": {
            "Id::AAMkAGMzNjc1ZDRmLTFlOTktNGQzNS04NTVmLTkwMDVkOWEyYmY0MQAuAAAAAACUFGw_S0XqRK5id50_416QAQCJMa30OofZSrcZSkuH_Y6QAAYFina4AAA=": "Marín, Cristhofer - AWG + Wakefern"
          },
          "type": "OpenApiConnectionNotification",
          "inputs": {
            "parameters": {
              "includeAttachments": false,
              "fetchOnlyWithAttachment": false,
              "folderPath": "Id::AAMkAGMzNjc1ZDRmLTFlOTktNGQzNS04NTVmLTkwMDVkOWEyYmY0MQAuAAAAAACUFGw_S0XqRK5id50_416QAQCJMa30OofZSrcZSkuH_Y6QAAYFina4AAA="
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
              "operationId": "OnNewEmailV3",
              "connectionName": "shared_office365"
            }
          }
        }
      },
      "actions": {
        "Initialize_SignatureHtml": {
          "runAfter": {},
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "SignatureHtml",
                "type": "string",
                "value": "<br>Regards,<br><table cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"border-collapse:collapse;\"><tr><td style=\"padding:0 14px 0 0;vertical-align:middle;\"><img src=\"data:image/png;base64,\" width=\"120\" height=\"61\" alt=\"P&amp;G\" style=\"display:block;border:0;\" /></td><td style=\"vertical-align:middle;font-family:Calibri,Arial,sans-serif;font-size:11pt;line-height:16pt;color:#000000;\">Cristhofer Mar&iacute;n Quir&oacute;s<br>pgcustservw2.im@pg.com<br>F&amp;A | NA Order Management Analyst | Regional Sales to Cash</td></tr></table><br>"
              }
            ]
          }
        },
        "AWG_-_CON_-_05_Get_Tracking_Item": {
          "runAfter": {
            "Initialize_SignatureHtml": [
              "Succeeded"
            ]
          },
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "dataset": "https://pgone.sharepoint.com/sites/NACSO-RegionalVMI",
              "table": "70ed8abc-c524-4142-9d8a-86f70ced426c",
              "$filter": "OriginalConversationId eq '@{triggerOutputs()?['body/conversationId']}' and Phase eq '05-FullTableRequestSent'",
              "$top": 1
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "operationId": "GetItems",
              "connectionName": "shared_sharepointonline"
            }
          }
        },
        "AWG_-_CON_-_05_Guard_Not_In_Flow": {
          "actions": {
            "Terminate_Not_Tracked": {
              "type": "Terminate",
              "inputs": {
                "runStatus": "Cancelled"
              }
            }
          },
          "runAfter": {
            "AWG_-_CON_-_05_Get_Tracking_Item": [
              "Succeeded"
            ]
          },
          "else": {
            "actions": {}
          },
          "expression": {
            "and": [
              {
                "equals": [
                  "@length(body('AWG_-_CON_-_05_Get_Tracking_Item')?['value'])",
                  0
                ]
              }
            ]
          },
          "type": "If"
        },
        "AWG_-_CON_-_05_Get_Client_Folder": {
          "runAfter": {
            "AWG_-_CON_-_05_Guard_Not_In_Flow": [
              "Succeeded"
            ]
          },
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "Uri": "https://graph.microsoft.com/v1.0/me/mailFolders/inbox/childFolders?$filter=displayName%20eq%20%27Mar%C3%ADn%2C%20Cristhofer%20-%20AWG%20%2B%20Wakefern%27&$top=1",
              "Method": "GET"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
              "operationId": "HttpRequest",
              "connectionName": "shared_office365"
            }
          }
        },
        "AWG_-_CON_-_05_Target_Client_Folder_Id": {
          "runAfter": {
            "AWG_-_CON_-_05_Get_Client_Folder": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "@first(body('AWG_-_CON_-_05_Get_Client_Folder')?['value'])?['id']"
        },
        "AWG_-_CON_-_05_Get_AWG_Complete_Folder": {
          "runAfter": {
            "AWG_-_CON_-_05_Target_Client_Folder_Id": [
              "Succeeded"
            ]
          },
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "Uri": "@concat('https://graph.microsoft.com/v1.0/me/mailFolders/', encodeUriComponent(outputs('AWG_-_CON_-_05_Target_Client_Folder_Id')), '/childFolders?$filter=displayName%20eq%20%27AWG%20Complete%27&$top=1')",
              "Method": "GET"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
              "operationId": "HttpRequest",
              "connectionName": "shared_office365"
            }
          }
        },
        "AWG_-_CON_-_05_Target_AWG_Complete_Folder_Id": {
          "runAfter": {
            "AWG_-_CON_-_05_Get_AWG_Complete_Folder": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "@first(body('AWG_-_CON_-_05_Get_AWG_Complete_Folder')?['value'])?['id']"
        },
        "AWG_-_CON_-_05_Get_AWG_CON_05_Folder": {
          "runAfter": {
            "AWG_-_CON_-_05_Target_AWG_Complete_Folder_Id": [
              "Succeeded"
            ]
          },
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "Uri": "@concat('https://graph.microsoft.com/v1.0/me/mailFolders/', encodeUriComponent(outputs('AWG_-_CON_-_05_Target_AWG_Complete_Folder_Id')), '/childFolders?$filter=displayName%20eq%20%27AWG%20-%20CON%20-%2005%27&$top=1')",
              "Method": "GET"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
              "operationId": "HttpRequest",
              "connectionName": "shared_office365"
            }
          }
        },
        "AWG_-_CON_-_05_Target_AWG_CON_05_Folder_Id": {
          "runAfter": {
            "AWG_-_CON_-_05_Get_AWG_CON_05_Folder": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "@first(body('AWG_-_CON_-_05_Get_AWG_CON_05_Folder')?['value'])?['id']"
        },
        "AWG_-_CON_-_05_HTTP_List_Client_Root_Messages": {
          "runAfter": {
            "AWG_-_CON_-_05_Target_AWG_CON_05_Folder_Id": [
              "Succeeded"
            ]
          },
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "Uri": "@concat('https://graph.microsoft.com/v1.0/me/mailFolders/', encodeUriComponent(outputs('AWG_-_CON_-_05_Target_Client_Folder_Id')), '/messages?$top=100&$select=id,subject,from,conversationId,parentFolderId,receivedDateTime,internetMessageId,categories')",
              "Method": "GET",
              "CustomHeader1": "Prefer: IdType=\"ImmutableId\"",
              "ContentType": "application/json"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
              "operationId": "HttpRequest",
              "connectionName": "shared_office365"
            }
          }
        },
        "AWG_-_CON_-_05_HTTP_List_AWGCON05_Messages": {
          "runAfter": {
            "AWG_-_CON_-_05_HTTP_List_Client_Root_Messages": [
              "Succeeded"
            ]
          },
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "Uri": "@concat('https://graph.microsoft.com/v1.0/me/mailFolders/', encodeUriComponent(outputs('AWG_-_CON_-_05_Target_AWG_CON_05_Folder_Id')), '/messages?$top=100&$select=id,subject,from,conversationId,parentFolderId,receivedDateTime,internetMessageId,categories')",
              "Method": "GET",
              "CustomHeader1": "Prefer: IdType=\"ImmutableId\"",
              "ContentType": "application/json"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
              "operationId": "HttpRequest",
              "connectionName": "shared_office365"
            }
          }
        },
        "AWG_-_CON_-_05_Filter_Current_Trigger_Email": {
          "runAfter": {
            "AWG_-_CON_-_05_HTTP_List_AWGCON05_Messages": [
              "Succeeded"
            ]
          },
          "type": "Query",
          "inputs": {
            "from": "@union(body('AWG_-_CON_-_05_HTTP_List_Client_Root_Messages')?['value'], body('AWG_-_CON_-_05_HTTP_List_AWGCON05_Messages')?['value'])",
            "where": "@if(empty(coalesce(triggerOutputs()?['body/internetMessageId'], '')), equals(item()?['conversationId'], triggerOutputs()?['body/conversationId']), equals(item()?['internetMessageId'], triggerOutputs()?['body/internetMessageId']))"
          }
        },
        "AWG_-_CON_-_05_Compose_Current_Immutable_ID": {
          "runAfter": {
            "AWG_-_CON_-_05_Filter_Current_Trigger_Email": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "@if(greater(length(body('AWG_-_CON_-_05_Filter_Current_Trigger_Email')), 0), first(body('AWG_-_CON_-_05_Filter_Current_Trigger_Email'))?['id'], coalesce(triggerOutputs()?['body/id'],''))"
        },
        "Initialize_variable": {
          "runAfter": {
            "AWG_-_CON_-_05_Compose_Reply_Target_Id": [
              "Succeeded"
            ]
          },
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "FirstCollective",
                "type": "string"
              }
            ]
          }
        },
        "Initialize_variable_1": {
          "runAfter": {
            "Initialize_variable": [
              "Succeeded"
            ]
          },
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "CollectiveMismatch",
                "type": "boolean"
              }
            ]
          }
        },
        "Initialize_variable_2": {
          "runAfter": {
            "Initialize_variable_1": [
              "Succeeded"
            ]
          },
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "FinalCcDynamic",
                "type": "string"
              }
            ]
          }
        },
        "Initialize_variable_3": {
          "runAfter": {
            "Initialize_variable_2": [
              "Succeeded"
            ]
          },
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "CollectiveBlankFound",
                "type": "boolean"
              }
            ]
          }
        },
        "Condition": {
          "actions": {
            "Apply_to_each": {
              "foreach": "@outputs('TableRows')",
              "actions": {
                "CurrentCollective": {
                  "type": "Compose",
                  "inputs": "@trim(\r\n  replace(\r\n    replace(\r\n      replace(\r\n        last(\r\n          split(\r\n            split(item(),'</td>')[5],\r\n            '<span style=\"font-family:&quot;Arial&quot;,sans-serif\">'\r\n          )\r\n        ),\r\n        '</span></p>',\r\n        ''\r\n      ),\r\n      '&nbsp;',\r\n      ''\r\n    ),\r\n    '<br>',\r\n    ''\r\n  )\r\n)"
                },
                "Condition_1": {
                  "actions": {
                    "Set_variable": {
                      "type": "SetVariable",
                      "inputs": {
                        "name": "FirstCollective",
                        "value": "@outputs('CurrentCollective')"
                      }
                    }
                  },
                  "runAfter": {
                    "Check_Collective_Blank": [
                      "Succeeded"
                    ]
                  },
                  "else": {
                    "actions": {
                      "Condition_2": {
                        "actions": {
                          "Set_variable_1": {
                            "type": "SetVariable",
                            "inputs": {
                              "name": "CollectiveMismatch",
                              "value": true
                            }
                          }
                        },
                        "else": {
                          "actions": {}
                        },
                        "expression": {
                          "and": [
                            {
                              "not": {
                                "equals": [
                                  "@outputs('CurrentCollective')",
                                  "@variables('FirstCollective')"
                                ]
                              }
                            }
                          ]
                        },
                        "type": "If"
                      }
                    }
                  },
                  "expression": {
                    "and": [
                      {
                        "equals": [
                          "@empty(variables('FirstCollective'))",
                          "@true"
                        ]
                      }
                    ]
                  },
                  "type": "If"
                },
                "Check_Collective_Blank": {
                  "actions": {
                    "Set_variable_2": {
                      "type": "SetVariable",
                      "inputs": {
                        "name": "CollectiveBlankFound",
                        "value": "@true"
                      }
                    }
                  },
                  "runAfter": {
                    "CurrentCollective": [
                      "Succeeded"
                    ]
                  },
                  "else": {
                    "actions": {}
                  },
                  "expression": {
                    "equals": [
                      "@empty(outputs('CurrentCollective'))",
                      "@true"
                    ]
                  },
                  "type": "If"
                }
              },
              "runAfter": {
                "FinalToText": [
                  "Succeeded"
                ]
              },
              "type": "Foreach"
            },
            "Condition_3": {
              "actions": {
                "FinalCcWithPGCS": {
                  "runAfter": {},
                  "type": "Compose",
                  "inputs": "@if(contains(toLower(outputs('FinalCc')), 'pgcustservw2.im@pg.com'), outputs('FinalCc'), concat(outputs('FinalCc'), 'pgcustservw2.im@pg.com;'))"
                },
                "AWG_-_CON_-_05_Filter_Cc_Addresses": {
                  "runAfter": {
                    "FinalCcWithPGCS": [
                      "Succeeded"
                    ]
                  },
                  "type": "Query",
                  "inputs": {
                    "from": "@split(coalesce(outputs('FinalCcWithPGCS'),''),';')",
                    "where": "@contains(item(),'@')"
                  }
                },
                "AWG_-_CON_-_05_Select_Cc_Objects": {
                  "runAfter": {
                    "AWG_-_CON_-_05_Filter_Cc_Addresses": [
                      "Succeeded"
                    ]
                  },
                  "type": "Select",
                  "inputs": {
                    "from": "@body('AWG_-_CON_-_05_Filter_Cc_Addresses')",
                    "select": {
                      "emailAddress": {
                        "address": "@trim(item())"
                      }
                    }
                  }
                },
                "AWG_-_CON_-_05_Compose_Customer_Reply_HTML": {
                  "runAfter": {
                    "AWG_-_CON_-_05_Select_Cc_Objects": [
                      "Succeeded"
                    ]
                  },
                  "type": "Compose",
                  "inputs": "<p class=\"editor-paragraph\">Hello team,<br><br>The following POs has been consolidated as requested:</p><br><p class=\"editor-paragraph\">@{outputs('HtmlTable')}</p>@{variables('SignatureHtml')}"
                },
                "AWG_-_CON_-_05_Compose_Customer_Reply_Safe": {
                  "runAfter": {
                    "AWG_-_CON_-_05_Compose_Customer_Reply_HTML": [
                      "Succeeded"
                    ]
                  },
                  "type": "Compose",
                  "inputs": "@replace(replace(replace(replace(outputs('AWG_-_CON_-_05_Compose_Customer_Reply_HTML'), '\\', '\\\\'), decodeUriComponent('%0D'), ' '), decodeUriComponent('%0A'), ' '), '\"', '\\\"')"
                },
                "DEBUG_Recipients": {
                  "runAfter": {
                    "AWG_-_CON_-_05_Compose_Customer_Reply_Safe": [
                      "Succeeded"
                    ]
                  },
                  "type": "Compose",
                  "inputs": "@concat('REPLY en hilo original. TargetId=', coalesce(outputs('AWG_-_CON_-_05_Compose_Reply_Target_Id'),''), ' | CC=', coalesce(outputs('FinalCcWithPGCS'),''))"
                },
                "AWG_-_CON_-_05_HTTP_Reply_Customer_Same_Thread": {
                  "runAfter": {
                    "DEBUG_Recipients": [
                      "Succeeded"
                    ]
                  },
                  "type": "OpenApiConnection",
                  "inputs": {
                    "parameters": {
                      "Uri": "v1.0/me/messages/@{encodeUriComponent(outputs('AWG_-_CON_-_05_Compose_Reply_Target_Id'))}/reply",
                      "Method": "POST",
                      "CustomHeader1": "Prefer: IdType=\"ImmutableId\"",
                      "Body": "@concat('{\"message\":{\"ccRecipients\":', string(body('AWG_-_CON_-_05_Select_Cc_Objects')), '},\"comment\":\"', outputs('AWG_-_CON_-_05_Compose_Customer_Reply_Safe'), '\"}')",
                      "ContentType": "application/json"
                    },
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
                      "operationId": "HttpRequest",
                      "connectionName": "shared_office365"
                    }
                  }
                },
                "AWG_-_CON_-_05_Advance_Phase": {
                  "runAfter": {
                    "AWG_-_CON_-_05_HTTP_Reply_Customer_Same_Thread": [
                      "Succeeded"
                    ]
                  },
                  "type": "OpenApiConnection",
                  "inputs": {
                    "parameters": {
                      "dataset": "https://pgone.sharepoint.com/sites/NACSO-RegionalVMI",
                      "table": "70ed8abc-c524-4142-9d8a-86f70ced426c",
                      "id": "@first(body('AWG_-_CON_-_05_Get_Tracking_Item')?['value'])?['ID']",
                      "item/Phase": "06-Consolidated",
                      "item/PhaseSince": "@utcNow()"
                    },
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                      "operationId": "PatchItem",
                      "connectionName": "shared_sharepointonline"
                    }
                  }
                },
                "AWG_-_CON_-_05_Get_ParentFlowId": {
                  "runAfter": {
                    "AWG_-_CON_-_05_Advance_Phase": [
                      "Succeeded"
                    ]
                  },
                  "type": "Compose",
                  "inputs": "@coalesce(first(body('AWG_-_CON_-_05_Get_Tracking_Item')?['value'])?['ParentFlowId'], '')"
                },
                "AWG_-_CON_-_05_Check_Has_Parent": {
                  "actions": {
                    "AWG_-_CON_-_05_Get_Sibling_Trackings": {
                      "type": "OpenApiConnection",
                      "inputs": {
                        "parameters": {
                          "dataset": "https://pgone.sharepoint.com/sites/NACSO-RegionalVMI",
                          "table": "70ed8abc-c524-4142-9d8a-86f70ced426c",
                          "$filter": "ParentFlowId eq '@{outputs('AWG_-_CON_-_05_Get_ParentFlowId')}'",
                          "$top": 100
                        },
                        "host": {
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                          "operationId": "GetItems",
                          "connectionName": "shared_sharepointonline"
                        }
                      }
                    },
                    "AWG_-_CON_-_05_Filter_Unfinished_Siblings": {
                      "runAfter": {
                        "AWG_-_CON_-_05_Get_Sibling_Trackings": [
                          "Succeeded"
                        ]
                      },
                      "type": "Query",
                      "inputs": {
                        "from": "@body('AWG_-_CON_-_05_Get_Sibling_Trackings')?['value']",
                        "where": "@not(equals(coalesce(item()?['Phase'], ''), '06-Consolidated'))"
                      }
                    },
                    "AWG_-_CON_-_05_Check_All_Siblings_Done": {
                      "actions": {
                        "AWG_-_CON_-_05_Get_Parent_Tracking": {
                          "type": "OpenApiConnection",
                          "inputs": {
                            "parameters": {
                              "dataset": "https://pgone.sharepoint.com/sites/NACSO-RegionalVMI",
                              "table": "70ed8abc-c524-4142-9d8a-86f70ced426c",
                              "$filter": "FlowId eq '@{outputs('AWG_-_CON_-_05_Get_ParentFlowId')}'",
                              "$top": 1
                            },
                            "host": {
                              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                              "operationId": "GetItems",
                              "connectionName": "shared_sharepointonline"
                            }
                          }
                        },
                        "AWG_-_CON_-_05_Guard_Parent_Exists": {
                          "actions": {
                            "AWG_-_CON_-_05_Advance_Parent_To_Completed": {
                              "type": "OpenApiConnection",
                              "inputs": {
                                "parameters": {
                                  "dataset": "https://pgone.sharepoint.com/sites/NACSO-RegionalVMI",
                                  "table": "70ed8abc-c524-4142-9d8a-86f70ced426c",
                                  "id": "@first(body('AWG_-_CON_-_05_Get_Parent_Tracking')?['value'])?['ID']",
                                  "item/Phase": "07-AllTrucksCompleted",
                                  "item/PhaseSince": "@utcNow()"
                                },
                                "host": {
                                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                                  "operationId": "PatchItem",
                                  "connectionName": "shared_sharepointonline"
                                }
                              }
                            }
                          },
                          "runAfter": {
                            "AWG_-_CON_-_05_Get_Parent_Tracking": [
                              "Succeeded"
                            ]
                          },
                          "else": {
                            "actions": {
                              "AWG_-_CON_-_05_DEBUG_Parent_Not_Found": {
                                "type": "Compose",
                                "inputs": "@concat('Parent tracking not found for ParentFlowId=', outputs('AWG_-_CON_-_05_Get_ParentFlowId'))"
                              }
                            }
                          },
                          "expression": {
                            "and": [
                              {
                                "greater": [
                                  "@length(body('AWG_-_CON_-_05_Get_Parent_Tracking')?['value'])",
                                  0
                                ]
                              }
                            ]
                          },
                          "type": "If"
                        }
                      },
                      "runAfter": {
                        "AWG_-_CON_-_05_Filter_Unfinished_Siblings": [
                          "Succeeded"
                        ]
                      },
                      "else": {
                        "actions": {
                          "AWG_-_CON_-_05_DEBUG_Siblings_Pending": {
                            "type": "Compose",
                            "inputs": "@concat('Still ', string(length(body('AWG_-_CON_-_05_Filter_Unfinished_Siblings'))), ' sibling(s) pending for ParentFlowId=', outputs('AWG_-_CON_-_05_Get_ParentFlowId'))"
                          }
                        }
                      },
                      "expression": {
                        "and": [
                          {
                            "equals": [
                              "@length(body('AWG_-_CON_-_05_Filter_Unfinished_Siblings'))",
                              0
                            ]
                          }
                        ]
                      },
                      "type": "If"
                    }
                  },
                  "runAfter": {
                    "AWG_-_CON_-_05_Get_ParentFlowId": [
                      "Succeeded"
                    ]
                  },
                  "else": {
                    "actions": {
                      "AWG_-_CON_-_05_DEBUG_No_Parent": {
                        "type": "Compose",
                        "inputs": "This tracking has no ParentFlowId. Skipping parent completion check."
                      }
                    }
                  },
                  "expression": {
                    "and": [
                      {
                        "not": {
